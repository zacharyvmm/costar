/* A button and an active-low LED on a costar GPIO port (ports/zephyr/module). */
/ {
	costar_gpio: costar-gpio {
		compatible = "costar,gpio";
		costar-device = "gpio";
		irq = <6>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	zephyr,user {
		button-gpios = <&costar_gpio 0 GPIO_ACTIVE_HIGH>;
		led-gpios = <&costar_gpio 1 GPIO_ACTIVE_LOW>;
	};
};
