# Zephyr drivers for costar devices (see include/costar.h).

config COSTAR_THREAD_INFO
	bool "Tell costar each thread's stack size"
	default y
	depends on ARCH_POSIX
	select THREAD_STACK_INFO
	help
	  costar's runner asks for each thread's declared stack size when the
	  thread starts, so that costar can check the thread stays within it.

config COSTAR_UART
	bool "UART on a costar channel device"
	default y
	depends on DT_HAS_COSTAR_UART_ENABLED
	depends on SERIAL
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT

config COSTAR_ENTROPY
	bool "Deterministic entropy, seeded from a costar registers device"
	default y
	depends on DT_HAS_COSTAR_ENTROPY_ENABLED
	depends on ENTROPY_GENERATOR
	select ENTROPY_HAS_DRIVER

config COSTAR_GPIO
	bool "GPIO on a costar registers device"
	default y
	depends on DT_HAS_COSTAR_GPIO_ENABLED
	depends on GPIO

config COSTAR_CAN
	bool "CAN controller on a costar channel device"
	default y
	depends on DT_HAS_COSTAR_CAN_ENABLED
	depends on CAN

config COSTAR_CAN_MAX_FILTERS
	int "Receive filters per costar CAN controller"
	default 16
	depends on COSTAR_CAN

config COSTAR_WDT
	bool "Watchdog on a costar watchdog device"
	default y
	depends on DT_HAS_COSTAR_WDT_ENABLED
	depends on WATCHDOG
	select HAS_WDT_NO_CALLBACKS

config COSTAR_I2C
	bool "I2C controller on a costar channel device"
	default y
	depends on DT_HAS_COSTAR_I2C_ENABLED
	depends on I2C
	select I2C_TRANSFER_TIMEOUT_SUPPORTED

config COSTAR_I2C_FRAME_SIZE
	int "Largest request or reply frame of a costar I2C transfer, in bytes"
	default 4096
	depends on COSTAR_I2C
	help
	  Each controller has one buffer of this size for a transfer's request
	  and then its reply: 3 bytes, plus 3 per message and a write's data;
	  4 bytes, plus the data read.  Larger transfers fail with -EINVAL.

config COSTAR_SPI
	bool "SPI controller on a costar channel device"
	default y
	depends on DT_HAS_COSTAR_SPI_ENABLED
	depends on SPI

config COSTAR_SPI_FRAME_SIZE
	int "Largest request or reply frame of a costar SPI controller, in bytes"
	default 4096
	depends on COSTAR_SPI
	help
	  Each controller has one buffer of this size for a request and then its
	  reply.  Longer transfers are split into frames of this size, within
	  one transaction.

config COSTAR_FLASH
	bool "Flash on a costar memory device"
	default y
	depends on DT_HAS_COSTAR_FLASH_ENABLED
	depends on FLASH
	select FLASH_HAS_DRIVER_ENABLED
	select FLASH_HAS_PAGE_LAYOUT
