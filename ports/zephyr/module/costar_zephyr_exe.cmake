# zephyr/zephyr.exe for the native_sim/native/64/costar board: a launcher
# that runs the application under costar, on one machine, with the console
# on standard output and ztest's verdict as the exit status.  Included by
# the module's CMakeLists.txt, inside the application's Zephyr build.
#
# What it makes, in the build's zephyr/ directory:
#   zephyr.so      the image: zephyr.elf linked with costar's runner, by
#                  costar_link_zephyr_image() as for costar_add_zephyr_image()
#                  (in a CMake project of its own, cmake/zephyr_image), with
#                  busy_poll.c if COSTAR_INSTRUMENT is set
#   costar.toml    a scenario: one machine, "zephyr", running zephyr.so; the
#                  run fails unless the firmware stops with status 0
#   zephyr.exe     `costar run costar.toml --format console`: the console
#                  text on standard output, in virtual time; arguments for
#                  Zephyr's own runner are ignored.  Runs are deterministic,
#                  so `costar run costar.toml` shows the same run's trace.
#
# The costar program is COSTAR_EXECUTABLE (a CMake or environment variable;
# with twister, -x COSTAR_EXECUTABLE=...), or else `costar` on the PATH.

zephyr_get(COSTAR_EXECUTABLE)
if(NOT COSTAR_EXECUTABLE)
  find_program(COSTAR_EXECUTABLE costar)
endif()
if(NOT COSTAR_EXECUTABLE)
  message(FATAL_ERROR "native_sim/native/64/costar runs zephyr.exe on costar, but there is no costar program: "
                      "set COSTAR_EXECUTABLE (twister: -x COSTAR_EXECUTABLE=/path/to/costar) or put costar on the PATH")
endif()
get_filename_component(costar ${COSTAR_EXECUTABLE} ABSOLUTE)
get_filename_component(costar_root ${CMAKE_CURRENT_LIST_DIR}/../../.. ABSOLUTE)

# The target that links zephyr.elf only exists at the end of Zephyr's own
# CMakeLists.txt: finish there.
function(costar_zephyr_exe costar_root costar)
  set(zephyr_dir ${APPLICATION_BINARY_DIR}/zephyr)
  set(image_build ${APPLICATION_BINARY_DIR}/costar-image)
  add_custom_target(costar_image ALL
    COMMAND ${CMAKE_COMMAND} -G ${CMAKE_GENERATOR} -S ${costar_root}/cmake/zephyr_image -B ${image_build}
            -DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM} -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
            -DCOSTAR_ZEPHYR_PYTHON=${PYTHON_EXECUTABLE} -DZEPHYR_BUILD=${APPLICATION_BINARY_DIR}
            -DZEPHYR_BASE=${ZEPHYR_BASE} -DCOSTAR_INSTRUMENT=${COSTAR_INSTRUMENT} > ${image_build}.log
    COMMAND ${CMAKE_COMMAND} --build ${image_build}
    BYPRODUCTS ${zephyr_dir}/zephyr.so
    COMMENT "Linking zephyr/zephyr.so, the application's costar image")
  add_dependencies(costar_image ${logical_target_for_zephyr_elf})

  get_filename_component(app ${APPLICATION_SOURCE_DIR} NAME)
  file(GENERATE OUTPUT ${zephyr_dir}/costar.toml CONTENT
"# Generated by costar's Zephyr module (ports/zephyr/module): this
# application on one costar machine.  zephyr.exe runs it.
name = \"${app}\"

[[machine]]
name = \"zephyr\"
image = \"zephyr.so\"

# ztest stops the CPU with the suite's result.
[[expect.event]]
label = \"stop\"
value = 0
")
  file(GENERATE OUTPUT ${zephyr_dir}/zephyr.exe CONTENT
"#!/bin/sh
# Generated by costar's Zephyr module (ports/zephyr/module): runs this
# application on costar.  Arguments for Zephyr's own runner are ignored.
exec '${costar}' run '${zephyr_dir}/costar.toml' --format console
"
    FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endfunction()
cmake_language(EVAL CODE
  "cmake_language(DEFER DIRECTORY [[${ZEPHYR_BASE}]] CALL costar_zephyr_exe [[${costar_root}]] [[${costar}]])")
