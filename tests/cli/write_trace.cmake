# `costar run --trace` must write through a file of its own: a stray
# <trace>.tmp (here a symlink to the trace, and a plain file) is left alone,
# and nothing else is left behind.
#   cmake -DCOSTAR=<costar-cli> -DSCENARIO=<toml> -DDIR=<scratch dir> -P write_trace.cmake
file(REMOVE_RECURSE ${DIR})
file(MAKE_DIRECTORY ${DIR})
foreach(stray IN ITEMS link file)
  set(trace ${DIR}/${stray}.trace)
  file(WRITE ${trace} "old\n")
  if(stray STREQUAL "link")
    file(CREATE_LINK ${trace} ${trace}.tmp SYMBOLIC)
  else()
    file(WRITE ${trace}.tmp "someone else's\n")
  endif()
  execute_process(COMMAND ${COSTAR} run ${SCENARIO} --trace ${trace} RESULT_VARIABLE result)
  file(READ ${trace} written)
  if(NOT result EQUAL 0 OR NOT written MATCHES "tx link 70696e67" OR IS_SYMLINK ${trace})
    message(FATAL_ERROR "${stray}: run --trace exited ${result} and wrote:\n${written}")
  endif()
  if(stray STREQUAL "file")
    file(READ ${trace}.tmp stray_content)
    if(NOT stray_content STREQUAL "someone else's\n")
      message(FATAL_ERROR "the stray ${trace}.tmp was changed")
    endif()
  endif()
endforeach()
file(GLOB left RELATIVE ${DIR} ${DIR}/*)
list(SORT left)
if(NOT left STREQUAL "file.trace;file.trace.tmp;link.trace;link.trace.tmp")
  message(FATAL_ERROR "unexpected files left behind: ${left}")
endif()
