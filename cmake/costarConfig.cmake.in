# costar's CMake package: find_package(costar) (see costar's CMakeLists.txt).
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost 1.83 CONFIG COMPONENTS context)
find_dependency(Threads)
if(@COSTAR_WITH_GRPC@)
  find_dependency(gRPC CONFIG)
endif()

include(${CMAKE_CURRENT_LIST_DIR}/costarTargets.cmake)

# The image and scenario functions, building from the installed ports and
# FreeRTOS kernel.
include(@PACKAGE_data_dir@/cmake/CostarFirmware.cmake)
include(@PACKAGE_data_dir@/cmake/CostarScenarios.cmake)

check_required_components(costar)
