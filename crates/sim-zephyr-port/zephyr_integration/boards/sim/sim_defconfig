# sim_defconfig — Default Kconfig for the Universal RTOS Native Simulator board
#
# Place at: boards/sim/sim_defconfig
# Build with: west build -b sim

# Platform
CONFIG_SOC_SERIES_SIM=y
CONFIG_SOC_SIM=y
CONFIG_BOARD_SIM=y

# Architecture: custom "sim" arch (uses our arch/sim/ port)
CONFIG_ARCH="sim"
CONFIG_ARCH_POSIX=n

# No hardware floating point needed (host CPU handles everything)
CONFIG_FLOAT=n

# Use the simulator's virtual console (UART)
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_SIM=y

# System clock: use virtual timer at 1 kHz tick rate
CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
CONFIG_SYSTEM_CLOCK_INIT_HZ=1000000

# Tickless kernel: let the Rust scheduler batch-advance ticks
CONFIG_TICKLESS_KERNEL=y

# Minimal kernel features for PoC
CONFIG_MULTITHREADING=y
CONFIG_NUM_PREEMPT_PRIORITIES=0     # Cooperative only for PoC (no preemption yet)
CONFIG_NUM_COOP_PRIORITIES=16
CONFIG_MAIN_THREAD_PRIORITY=0

# No userspace (simplifies syscall codegen)
CONFIG_USERSPACE=n

# No networking for PoC (use sim-net later)
CONFIG_NETWORKING=n

# No filesystem
CONFIG_FILE_SYSTEM=n

# Enable the simulator's thread registry bridge
CONFIG_SIM_THREAD_REGISTRY=y

# Use host malloc/free (bypass Zephyr's heap)
CONFIG_HEAP_MEM_POOL_SIZE=0
